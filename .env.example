# --- Supabase project (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Settings → Database → Connection string, "Transaction" pooler) ---
# Used by Drizzle (src/db/client.ts) and drizzle-kit (drizzle.config.ts).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Email (Milestone 4+, Resend) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notifications digest (Milestone 10) ---
# Shared secret for GET /api/cron/notifications-digest. No scheduler is
# configured in this environment — point an external one (Vercel Cron, a
# GitHub Action, cron-job.org, ...) at that route with this value as a
# `Authorization: Bearer <secret>` header once you have a real deployment.
CRON_SECRET=
